{
    "name": "ctidigital/magento2-configurator",
    "description": "Keep magento persistently configured using files",
    "type": "magento2-module",
    "require": {
        "symfony/yaml": "^7.0",
        "magento/module-catalog-import-export": "^101.0.0",
        "ext-exif": "*",
        "php": "^8.3"
    },
    "require-dev": {
        "phpmd/phpmd": "^2.15",
        "squizlabs/php_codesniffer": "^3.13",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12",
        "magento/magento-coding-standard": ">=36"
    },
    "version": "4.1.0",
    "scripts": {
        "test":    "vendor/bin/phpunit --configuration phpunit.xml",
        "cs":      "vendor/bin/phpcs --standard=phpcs.xml",
        "md":      "vendor/bin/phpmd Api,Component,Console,Exception,Model,Service text phpmd.xml",
        "analyse": ["@cs", "@md"]
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CtiDigital\\Configurator\\": ""
        }
    },
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
