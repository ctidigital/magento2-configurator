<?xml version="1.0"?>
<ruleset name="CtiDigital Configurator"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd"
>
    <description>PHP_CodeSniffer configuration for magento2-configurator.</description>

    <!-- ── Standard ─────────────────────────────────────────────────────── -->
    <rule ref="Magento2"/>

    <!-- ── Scope ─────────────────────────────────────────────────────────── -->
    <file>.</file>

    <!-- Exclude generated / third-party / test directories -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/Test/*</exclude-pattern>

    <!-- ── File types ────────────────────────────────────────────────────── -->
    <arg name="extensions" value="php"/>

    <!-- ── Output ────────────────────────────────────────────────────────── -->
    <!-- -n: errors only (no warnings). Remove this arg to see all ~700 warnings. -->
    <arg value="n"/>
    <arg name="colors"/>
    <arg name="parallel" value="4"/>
</ruleset>
